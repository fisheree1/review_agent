# Installed as a root-only include. Replace __GATEWAY_TOKEN__ on the server.
# The existing portal /_portal_auth location validates the administrator cookie.
location = /review {
    return 308 /review/;
}
location ^~ /review/api/ {
    auth_request /_portal_auth;
    error_page 401 = @review_unauthenticated;
    client_max_body_size 26m;
    proxy_pass http://127.0.0.1:18081/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Review-Gateway "__GATEWAY_TOKEN__";
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    access_log off;
}
location ^~ /review/ {
    auth_request /_portal_auth;
    error_page 401 = @portal_login;
    proxy_pass http://127.0.0.1:18081/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Review-Gateway "__GATEWAY_TOKEN__";
    access_log off;
}
location @review_unauthenticated {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    return 401 '{"error":{"code":"AUTHENTICATION_REQUIRED","message":"请通过门户登录"}}';
}
