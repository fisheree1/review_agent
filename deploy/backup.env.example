# Copy to /etc/review-agent/backup.env with root ownership and mode 0600.
# The repository must be on another server/account, never the local MinIO volume.
RESTIC_REPOSITORY=s3:https://offsite-object-store.example/your-backup-bucket
RESTIC_PASSWORD_FILE=/etc/review-agent/restic-password
BACKUP_STAGING_DIR=/var/lib/review-agent-backup
PROD_SECRETS_DIR=/etc/review-agent/secrets
# Add only the credentials required by your restic repository backend.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
